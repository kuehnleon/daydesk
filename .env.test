# Committed test env — used by `npm run test:e2e` locally AND by the CI e2e job.
# All values here are non-secret placeholders for a disposable local Postgres and
# a fake OIDC identity. Real secrets never live here.
#
# One thing you MUST fill in locally (leave blank for CI, which generates them):
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY. `next build` validates these are real
# P-256 keys. Generate a throwaway pair with:
#
#   node -e "const k=require('web-push').generateVAPIDKeys();\
#            console.log('VAPID_PUBLIC_KEY='+k.publicKey);\
#            console.log('VAPID_PRIVATE_KEY='+k.privateKey)"
#
# and paste over the empty values below. They stay on your machine (gitignored
# via the `!.env.test` whitelist only unblocking this exact filename; edits
# won't be committed accidentally because the empty template is what's tracked).

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daydesk_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/daydesk_test
NEXTAUTH_SECRET=e2e-fixed-secret-do-not-use-in-production-32chars
NEXTAUTH_URL=http://localhost:3100

# OIDC placeholders — tests never hit the provider, but `next build` reads them.
OAUTH_ISSUER=http://localhost/oidc
OAUTH_CLIENT_ID=test
OAUTH_CLIENT_SECRET=test
OAUTH_LOGOUT_URL=http://localhost/logout

# Fill in locally (see comment at top). CI overrides these via `$GITHUB_ENV`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:e2e@example.test
PUSH_API_SECRET=e2e

# Silence the service-worker registration to keep the test console clean.
NEXT_PUBLIC_DISABLE_SW=1

# Disable the artificial 300ms skeleton delay — tests want deterministic
# renders as soon as data arrives.
NEXT_PUBLIC_SKELETON_MIN_MS=0
