DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daydesk_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/daydesk_test
NEXTAUTH_SECRET=e2e-fixed-secret-do-not-use-in-production-32chars
NEXTAUTH_URL=http://localhost:3100

# Placeholders so `next build` accepts the OIDC config. Tests never hit these.
OAUTH_ISSUER=http://localhost/oidc
OAUTH_CLIENT_ID=test
OAUTH_CLIENT_SECRET=test
OAUTH_LOGOUT_URL=http://localhost/logout

# VAPID keys are validated at `next build` time. Generate a throwaway pair
# for local runs with:
#
#   node -e "const k=require('web-push').generateVAPIDKeys();\
#            console.log('VAPID_PUBLIC_KEY='+k.publicKey);\
#            console.log('VAPID_PRIVATE_KEY='+k.privateKey)"
#
# then paste the two lines below (they never leave your machine).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:e2e@example.test
PUSH_API_SECRET=e2e

# Silence the service-worker registration to keep console clean.
NEXT_PUBLIC_DISABLE_SW=1
